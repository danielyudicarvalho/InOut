# Copy to .env. Do not commit .env. No live credentials belong here.
API_BASE_URL=http://localhost:8080
AUTH_WEB_CLIENT_SECRET=dev-only-web-client-secret
# 32-byte key, base64. Required in production. Empty uses the documented development key.
BFF_SESSION_KEY=
AUTH_ISSUER=http://localhost:8080/
AUTH_PUBLIC_ORIGIN=http://localhost:3000
INOUT_DB_PASSWORD=change-me
INOUT_DIRECT_PASSWORD=change-me

# Docker API port binding. 127.0.0.1 keeps the API local; 0.0.0.0 exposes it
# to the LAN (needed only to test from a physical phone).
API_BIND_ADDRESS=127.0.0.1

# Resend Email Delivery
# Values for Auth__Email__Delivery: resend | smtp | capture (development only)
# Production requires AUTH_EMAIL_FROM on a domain verified in Resend.
AUTH_EMAIL_DELIVERY=capture
RESEND_API_KEY=
AUTH_EMAIL_FROM="InOut <noreply@yourdomain.com>"

# Sentry (Backend). Sentry__TracesSampleRate defaults to 0.1.
SENTRY_DSN=

# PostHog (Backend)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# PostHog (Web Frontend)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (Web Frontend)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time only, for source map upload:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
