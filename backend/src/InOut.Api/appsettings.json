{
  "AllowedHosts": "*",
  "Database": {
    "Provider": "npgsql",
    "PoolMode": "session",
    "MaxPoolSize": 10,
    "WorkerProcessCount": 0,
    "MachineCount": 0,
    "ClusterClientLimit": 0
  },
  "Deployment": {
    "RegionApproved": false,
    "Region": ""
  },
  "Auth": {
    "Issuer": "",
    "PublicOrigin": "",
    "Email": {
      "Delivery": ""
    }
  },
  "IdentityImport": {
    "Mode": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  }
}
