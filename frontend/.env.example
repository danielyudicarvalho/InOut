# The browser calls this Next server. Tokens are not public configuration.
# Server-only values belong in the process environment, not in NEXT_PUBLIC_*.
# API_BASE_URL=http://localhost:8080
# AUTH_WEB_CLIENT_SECRET=dev-only-web-client-secret
# BFF_SESSION_KEY=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
