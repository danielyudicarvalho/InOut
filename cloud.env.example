# Copy to .env.cloud and supply credentials from your Supabase project.
# Point to a development/staging project; API writes affect this remote database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Npgsql connection string for the restricted inout_api_runtime role.
# Use the project pooler host when direct IPv6 connectivity is unavailable.
# Never use the postgres or service_role credentials for the API.
INOUT_CLOUD_DATABASE_URL=Host=your-pooler-host;Port=5432;Database=postgres;Username=inout_api_runtime.your-project-ref;Password=your-runtime-password;SSL Mode=Require
